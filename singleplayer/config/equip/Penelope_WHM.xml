	<gearlock>
		<equip set="Gearlock" />
	</gearlock>

	<idlegear>
		<if p_status="engaged">
			<equip set="Engaged" />
		</if>
		<elseif p_status="resting">
			<equip set="MPHeal" />
		</elseif>
		<else>
			<equip set="Idle" />
		</else>
	</idlegear>

	<premagic>
		<equip set="FastCast" />
	</premagic>
		
	<midmagic>
		<if ad_type="WhiteMagic">
			<if ad_name="Cure*|Curaga*">
				<if p_hpp="<75" p_tp="<1000">
					<equip set="YellowCure" />
				</if>
				<else>
					<equip set="Cure" />
				</else>
			</if>
			<else>
				<equip set="MND" />
			</else>
		</if>
		
		<if ad_type="BlackMagic">
			<equip set="INT" />
			<if ad_skill="ElementalMagic">
				<equip set="Elemental" />
			</if>
			<else>
				<equip set="INT" />
			</else>
		</if>
		
		<if ad_type="WhiteMagic|BlackMagic">
			<equip set="Staff_%ad_element" />
		</if>
	</midmagic>

