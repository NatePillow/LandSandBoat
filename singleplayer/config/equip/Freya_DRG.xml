	<variables>
		<var name="autows">0</var>
	</variables>
	
	<inputcommands>
		<cmd input="/wson">
			<setvar name="autows" values="1"/>
			<addtochat colo="50">Auto WS enabled!</addtochat>
		</cmd>
		<cmd input="/wsoff">
			<setvar name="autows" values="0"/>
			<addtochat colo="50">Auto WS disabled!</addtochat>
		</cmd>
	</inputcommands>

	<idlegear>
		<if p_status="engaged">
			<equip set="Engaged" />
			<if p_tp=">999">
				<if advanced="$autows=1">
					<command>/ws "Double Thrust" &lt;t&gt;</command>
				</if>
			</if>
		</if>
		<else>
			<equip set="Idle" />
